{
    "name": "tibor-src/a2a-laravel",
    "description": "Laravel package for the Agent2Agent (A2A) protocol with Laravel AI SDK integration",
    "keywords": ["php", "laravel", "a2a", "agent2agent", "ai", "sdk", "agents"],
    "license": "MIT",
    "authors": [
        {
            "name": "Tibor",
            "homepage": "https://github.com/tibor-src"
        }
    ],
    "require": {
        "php": "^8.5.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.4",
        "nyholm/psr7": "^1.8",
        "symfony/psr-http-message-bridge": "^7.2|^8.0",
        "tibor-src/a2a-php": "^0.1.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^8.6",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.29.3",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^5.0.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0.0",
        "pestphp/pest-plugin-rector": "^5.0.0",
        "pestphp/pest-plugin-type-coverage": "^5.0.0",
        "phpstan/phpstan": "^2.2.5",
        "rector/rector": "^2.5.7"
    },
    "suggest": {
        "laravel/sanctum": "Map A2A HTTP bearer security schemes to Sanctum tokens and abilities",
        "laravel/passport": "Use Passport as the A2A bearer guard via a2a.auth.guard",
        "laravel/horizon": "Monitor A2A queued execution",
        "laravel/mcp": "Optional MCP server for the same Laravel AI agent (not bundled in v0.1.0)"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/tibor-src/a2a-php.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "TiborSrc\\A2A\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TiborSrc\\A2A\\Laravel\\A2AServiceProvider"
            ],
            "aliases": {
                "A2A": "TiborSrc\\A2A\\Laravel\\Facades\\A2A"
            }
        }
    },
    "scripts": {
        "lint": [
            "pint --parallel",
            "rector"
        ],
        "refactor": "rector",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:refactor": "rector --dry-run",
        "test:unit": "pest --coverage --exactly=100",
        "test:types": "phpstan --memory-limit=1G",
        "test:tck": "php scripts/tck.php",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
